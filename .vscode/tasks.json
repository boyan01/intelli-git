{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Watch All (Run Extension)",
			"type": "shell",
			"command": "npm run watch:extension",
			"options": {
				"env": {
					"MODE": "debug"
				}
			},
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "."
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "build started\\.{3}",
					"endsPattern": "built in \\d+ms\\."
				}
			},
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchters"
			},
			"group": "build"
		},
		{
			"type": "npm",
			"script": "compile",
			"problemMatcher": "$tsc",
			"group": "build",
			"presentation": {
				"reveal": "never"
			}
		},
		{
			"label": "Watch All",
			"dependsOn": [
				"Watch All (Run Extension)"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
