{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchters"
			},
			"group": "build"
		},
		{
			"type": "npm",
			"script": "watch:webview",
			"problemMatcher": {
				"owner": "typescript",
				"fileLocation": "relative",
				"pattern": {
					"regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
					"file": 1,
					"location": 2,
					"severity": 3,
					"code": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "vite v[\\d.]+ building",
					"endsPattern": "built in \\d+ms"
				}
			},
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchters"
			},
			"group": "build"
		},
		{
			"type": "npm",
			"script": "compile",
			"problemMatcher": "$tsc",
			"group": "build",
			"presentation": {
				"reveal": "never"
			}
		},
		{
			"label": "Watch All",
			"dependsOn": [
				"npm: watch",
				"npm: watch:webview"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}