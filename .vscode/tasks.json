{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch All (Run Extension)",
      "type": "shell",
      "command": "npm run watch:extension",
      "options": {
        "env": {
          "MODE": "debug"
        }
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "build started\\.{3}",
          "endsPattern": "built in \\d+ms\\."
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "group": "watchters"
      },
      "group": "build"
    },
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "group": "build",
      "presentation": {
        "reveal": "never"
      }
    },
    {
      "label": "Setup Checkout Test Fixture",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/apps/extension/scripts/setup-checkout-test.sh", "${input:checkoutScenario}"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BASE_DIR": "${workspaceFolder}/.test/intelli-git-test/debug"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Prepare Checkout Test and Watch",
      "dependsOrder": "sequence",
      "dependsOn": ["Setup Checkout Test Fixture", "Watch All (Run Extension)"],
      "problemMatcher": []
    },
    {
      "label": "Watch All",
      "dependsOn": ["Watch All (Run Extension)"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "checkoutScenario",
      "type": "pickString",
      "description": "Select a checkout test scenario",
      // Keep these options in sync with apps/extension/scripts/setup-checkout-test.sh.
      "options": [
        "clean-remote",
        "safe",
        "conflict",
        "untracked",
        "staged",
        "mixed",
        "local-clean",
        "ahead",
        "behind",
        "diverged",
        "ahead-conflict",
        "behind-conflict",
        "merge-conflict",
        "rebase-conflict",
        "stash-pop-conflict"
      ],
      "default": "merge-conflict"
    }
  ]
}
