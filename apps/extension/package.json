    "configuration": {
      "title": "Intelli Git",
      "properties": {
        "intelli-git.ai.provider": {
          "type": "string",
          "default": "copilot",
          "enum": [
            "copilot",
            "anthropic",
            "google",
            "custom"
          ],
          "enumDescriptions": [
            "%intelli-git.config.ai.provider.copilot%",
            "%intelli-git.config.ai.provider.anthropic%",
            "%intelli-git.config.ai.provider.google%",
            "%intelli-git.config.ai.provider.custom%"
          ],
          "markdownDescription": "%intelli-git.config.ai.provider.markdownDescription%"
        },
        "intelli-git.ai.commitPrompt": {
          "type": "string",
          "default": "Generate a concise commit message based on the following diff. Use the conventional commits format (e.g. feat: ..., fix: ...). Only return the commit message, no explanation, no code blocks.",
          "editPresentation": "multilineText",
          "markdownDescription": "%intelli-git.config.ai.commitPrompt.markdownDescription%"
        },
        "intelli-git.changelist.mode": {
          "type": "string",
          "default": "staged",
          "enum": [
            "staged",
            "changes"
          ],
          "enumDescriptions": [
            "%intelli-git.config.changelist.mode.staged%",
            "%intelli-git.config.changelist.mode.changes%"
          ],
          "description": "%intelli-git.config.changelist.mode.description%"
        },
        "intelli-git.editor.changeBlockDecorations": {
          "type": "string",
          "default": "allEditors",
          "enum": [
            "off",
            "diffOnly",
            "allEditors"
          ],
          "enumDescriptions": [
            "%intelli-git.config.editor.changeBlockDecorations.off%",
            "%intelli-git.config.editor.changeBlockDecorations.diffOnly%",
            "%intelli-git.config.editor.changeBlockDecorations.allEditors%"
          ],
          "description": "%intelli-git.config.editor.changeBlockDecorations.description%"
        },
        "intelli-git.ai.copilot.model": {
          "type": "string",
          "default": "gpt-5-mini",
          "description": "%intelli-git.config.ai.copilot.model.description%"
        },
        "intelli-git.ai.anthropic.apiKey": {
          "type": "string",
          "default": "",
          "deprecationMessage": "%intelli-git.config.ai.apiKey.deprecated%",
          "markdownDescription": "%intelli-git.config.ai.apiKey.markdownDescription%"
        },
        "intelli-git.ai.anthropic.model": {
          "type": "string",
          "default": "",
          "description": "%intelli-git.config.ai.anthropic.model.description%"
        },
        "intelli-git.ai.anthropic.apiUrl": {
          "type": "string",
          "default": "",
          "description": "%intelli-git.config.ai.anthropic.apiUrl.description%"
        },
        "intelli-git.ai.google.apiKey": {
          "type": "string",
          "default": "",
          "deprecationMessage": "%intelli-git.config.ai.apiKey.deprecated%",
          "markdownDescription": "%intelli-git.config.ai.apiKey.markdownDescription%"
        },
        "intelli-git.ai.google.model": {
          "type": "string",
          "default": "gemini-1.5-pro",
          "description": "%intelli-git.config.ai.google.model.description%"
        },
        "intelli-git.ai.google.apiUrl": {
          "type": "string",
          "default": "https://generativelanguage.googleapis.com",
          "description": "%intelli-git.config.ai.google.apiUrl.description%"
        },
        "intelli-git.ai.custom.apiKey": {
          "type": "string",
          "default": "",
          "deprecationMessage": "%intelli-git.config.ai.apiKey.deprecated%",
          "markdownDescription": "%intelli-git.config.ai.apiKey.markdownDescription%"
        },
        "intelli-git.ai.custom.model": {
          "type": "string",
          "default": "gpt-3.5-turbo",
          "description": "%intelli-git.config.ai.custom.model.description%"
        },
        "intelli-git.ai.custom.apiUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "%intelli-git.config.ai.custom.apiUrl.description%"
        }
      }
    }
  },
  "scripts": {
    "clean": "rm -rf out",
    "package": "INTELLI_GIT_BUILD_CHANNEL=marketplace vsce package --allow-missing-repository --baseContentUrl ${VSCE_BASE_CONTENT_URL:-https://raw.githubusercontent.com/boyan01/intelli-git/main/apps/extension} --baseImagesUrl ${VSCE_BASE_IMAGES_URL:-https://boyan01.github.io/intelli_git} -o ../../out/intelli-git-${npm_package_version}.vsix && npm run audit:release-channel -- --channel marketplace --vsix ../../out/intelli-git-${npm_package_version}.vsix",
    "package:dev": "node scripts/package-dev.js",
    "publish:marketplace": "INTELLI_GIT_BUILD_CHANNEL=marketplace vsce publish --allow-missing-repository --baseContentUrl ${VSCE_BASE_CONTENT_URL:-https://raw.githubusercontent.com/boyan01/intelli-git/main/apps/extension} --baseImagesUrl ${VSCE_BASE_IMAGES_URL:-https://boyan01.github.io/intelli_git}",
    "audit:release-channel": "node scripts/audit-release-channel.js",
    "vscode:prepublish": "npm run compile",
    "generate:icons": "node scripts/generate-icons.js",
    "sync:l10n": "node scripts/sync-l10n.js",
    "build:webview": "cd ../webview-ui && npm run build",
    "bundle:extension": "node scripts/build-extension.js",
    "compile": "npm run generate:icons && npm run sync:l10n && npm run build:webview && tsc -p tsconfig.json --noEmit && npm run bundle:extension",
    "watch": "npm run generate:icons && npm run sync:l10n && concurrently --raw \"tsc -watch -p tsconfig.json --noEmit\" \"node scripts/build-extension.js --watch\"",
    "watch:webview": "cd ../webview-ui && npm run watch",
    "lint": "eslint src",
    "test:regression": "node scripts/run-regression-tests.js",
    "test:unit": "vitest run --config vitest.config.ts",
    "test": "npm run test:regression && npm run test:unit"
  },
  "dependencies": {
    "simple-git": "^3.33.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vscode/vsce": "^3.9.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.1.0",
    "fantasticon": "^4.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.0.15"
  }
}
