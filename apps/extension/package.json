      "view/title": [
        {
          "command": "intelli-git.repository.switch",
          "when": "view == intelliGitView && intelli-git.hasMultipleRepositories",
          "group": "navigation@1"
        },
        {
          "command": "intelli-git.worktrees.toggleDrawer",
          "when": "view == intelliGitView && intelli-git.hasMultipleWorktrees",
          "group": "navigation@2"
        },
        {
          "command": "intelli-git.repository.scanWorkspace",
          "when": "view == intelliGitView",
          "group": "3_repository@1"
        },
        {
          "command": "intelli-git.repository.add",
          "when": "view == intelliGitView",
          "group": "3_repository@2"
        },
        {
          "submenu": "intelli-git.changelistMode",
          "when": "view == intelliGitView && intelli-git.hasActiveRepository",
          "group": "2_mode@1"
        }
      ],
      "view/item/context": [
        {
          "command": "intelli-git.showBranchPicker",
          "when": "viewItem == branchStatusBar",
          "group": "inline"
        }
      ],
      "webview/context": [
        {
          "command": "intelli-git.worktree.switch",
          "when": "webviewSection == 'worktreeItem' && pathExists == true && isActiveRepository != true",
          "group": "0_navigation@1"
