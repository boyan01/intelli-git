{
  "name": "intelli-git",
  "displayName": "Intelli Git",
  "description": "JetBrains-style Git tools for VS Code: an IntelliJ IDEA-like commit panel, changelists, stash, and Git log workflows.",
  "version": "0.0.5",
  "publisher": "boyan01",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/boyan01/intelli-git-feedback#readme",
  "bugs": {
    "url": "https://github.com/boyan01/intelli-git-feedback/issues"
  },
  "qna": "https://github.com/boyan01/intelli-git-feedback/issues/new/choose",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1F6FEB",
    "theme": "dark"
  },
  "keywords": [
    "git",
    "commit",
    "commit-panel",
    "changelist",
    "git-log",
    "idea",
    "scm",
    "intellij",
    "intellij-idea",
    "jetbrains",
    "stash"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "l10n": "./l10n",
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "intelli-git-worktree": {
        "description": "Intelli Git worktree icon",
        "default": {
          "fontPath": "resources/intelli-git-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "intelli-git-broom": {
        "description": "Intelli Git prune stale worktrees icon",
        "default": {
          "fontPath": "resources/intelli-git-icons.woff",
          "fontCharacter": "\\E002"
        }
      },
      "intelli-git-logo": {
        "description": "Intelli Git logo icon",
        "default": {
          "fontPath": "resources/intelli-git-icons.woff",
          "fontCharacter": "\\E003"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "intelli-git-container",
          "title": "%intelli-git.viewsContainers.activitybar.title%",
          "icon": "$(intelli-git-logo)"
        }
      ],
      "panel": [
        {
          "id": "intelli-git-panel",
          "title": "%intelli-git.viewsContainers.panel.title%",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "intelli-git-container": [
        {
          "icon": "$(git-commit)",
          "type": "webview",
          "id": "intelliGitView",
          "name": "%intelli-git.views.intelli-git-container.title%"
        }
      ],
      "intelli-git-panel": [
        {
          "icon": "$(git-branch)",
          "type": "webview",
          "id": "intelli-git.logView",
          "name": "%intelli-git.views.intelli-git-log.title%"
        }
      ]
    },
