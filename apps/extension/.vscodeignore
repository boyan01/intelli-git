# Exclude paths that npm workspace dependency detection reports above this package root
../**
../../**

# Source files (not needed after compilation)
src/**
webview-ui/**
out/apps/**
out/packages/**
out/src/**

# Development and test files
.vscode/**
.agent/**
.test/**
.git/**
.gitignore
node_modules/**
**/*.map
*.ts
!*.d.ts
tsconfig.json
eslint.config.mjs
eslint.config.cjs
scripts/**

# Webview node_modules (build artifacts are in out/webview)
webview-ui/node_modules/**
out/webview/vite.svg

# Other unnecessary files
*.vsix
.DS_Store
**/.DS_Store
*.log
npm-debug.log*
