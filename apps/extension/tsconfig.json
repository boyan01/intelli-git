{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "sourceMap": true,
    "rootDir": "../..",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "out",
    "types": [
      "node",
      "vscode"
    ],
    "paths": {
      "@shared/*": [
        "../../packages/shared/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "webview-ui",
    "../../packages/shared"
  ]
}