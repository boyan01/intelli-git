{
  "name": "idea-commit-panel",
  "displayName": "%idea-commit-panel.displayName%",
  "description": "%idea-commit-panel.description%",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "l10n": "./l10n",
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "idea-commit-container",
          "title": "%idea-commit-panel.viewsContainers.activitybar.title%",
          "icon": "resources/git-icon.svg"
        }
      ]
    },
    "views": {
      "idea-commit-container": [
        {
          "icon": "$(git-commit)",
          "type": "webview",
          "id": "ideaCommitView",
          "name": "%idea-commit-panel.views.idea-commit-container.title%"
        }
      ]
    },
    "commands": [
      {
        "command": "idea-commit-panel.refresh",
        "title": "%idea-commit-panel.commands.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "idea-commit-panel.push",
        "title": "%idea-commit-panel.commands.push.title%",
        "icon": "$(repo-push)"
      },
      {
        "command": "idea-commit-panel.showBranchPicker",
        "title": "%idea-commit-panel.commands.showBranchPicker.title%"
      },
      {
        "command": "idea-commit-panel.focusCommitView",
        "title": "%idea-commit-panel.commands.focusCommitView.title%"
      },
      {
        "command": "idea-commit-panel.copyCommitHash",
        "title": "%idea-commit-panel.commands.copyCommitHash.title%"
      },
      {
        "command": "idea-commit-panel.stashPop",
        "title": "%idea-commit-panel.commands.stashPop.title%"
      },
      {
        "command": "idea-commit-panel.stashApply",
        "title": "%idea-commit-panel.commands.stashApply.title%"
      },
      {
        "command": "idea-commit-panel.stashDrop",
        "title": "%idea-commit-panel.commands.stashDrop.title%"
      },
      {
        "command": "idea-commit-panel.stashShowDiff",
        "title": "%idea-commit-panel.commands.stashShowDiff.title%"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "idea-commit-panel.showBranchPicker",
          "when": "viewItem == branchStatusBar",
          "group": "inline"
        }
      ],
      "webview/context": [
        {
          "command": "idea-commit-panel.copyCommitHash",
          "when": "webviewSection == 'commitItem'",
          "group": "1_cutcopypaste"
        },
        {
          "command": "idea-commit-panel.stashPop",
          "when": "webviewSection == 'stashItem'",
          "group": "1_modification@1"
        },
        {
          "command": "idea-commit-panel.stashApply",
          "when": "webviewSection == 'stashItem'",
          "group": "1_modification@2"
        },
        {
          "command": "idea-commit-panel.stashDrop",
          "when": "webviewSection == 'stashItem'",
          "group": "1_modification@3"
        },
        {
          "command": "idea-commit-panel.stashShowDiff",
          "when": "webviewSection == 'stashItem'",
          "group": "2_view"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:webview": "cd webview-ui && npm run build",
    "compile": "npm run build:webview && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "watch:webview": "cd webview-ui && npm run watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^22.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "simple-git": "^3.30.0"
  }
}