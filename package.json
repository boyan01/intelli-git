{
  "name": "idea-commit-pannel-monorepo",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces --if-present",
    "compile": "npm run compile --workspaces --if-present",
    "watch": "npm run watch --workspaces --if-present",
    "watch:extension": "concurrently -n \"extension,webview\" -c \"cyan,magenta\" \"npm run watch --workspace intelli-git\" \"npm run watch --workspace webview-ui\"",
    "package:extension": "INTELLI_GIT_BUILD_CHANNEL=marketplace npm run package --workspace=intelli-git",
    "package:extension:open-vsx": "INTELLI_GIT_BUILD_CHANNEL=marketplace npm run package:open-vsx --workspace=intelli-git",
    "package:extension:dev": "INTELLI_GIT_BUILD_CHANNEL=dev MODE=dev npm run package:dev --workspace=intelli-git",
    "install:extension:dev": "INTELLI_GIT_BUILD_CHANNEL=dev MODE=dev npm run package:dev --workspace=intelli-git -- --install",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:release",
    "test": "npm run test --workspaces --if-present",
    "test:release": "node --test scripts/release.test.js"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "esbuild": "^0.28.0",
    "prettier": "3.9.9",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/boyan01/intelli-git.git"
  }
}
